# Development-only defaults used by startup.sh; override via the environment.
# Real credentials must come from environment or secret storage and are never committed.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asset_health
DB_ADMIN_USER=appadmin
DB_ADMIN_PASSWORD=change-me
# Migration-owner role: owns the database and public schema, runs Alembic (DDL).
DB_MIGRATION_USER=asset_migrator
DB_MIGRATION_PASSWORD=change-me-migrator
# Runtime role: DML only (SELECT/INSERT/UPDATE), no CREATE, no DELETE.
DB_APP_USER=asset_app
DB_APP_PASSWORD=change-me-app

# Settings the backend consumes (startup.sh writes these, URL-encoded, to database_urls.env):
# MIGRATION_DATABASE_URL=postgresql+psycopg://<DB_MIGRATION_USER>:<password>@localhost:5432/asset_health
# DATABASE_URL=postgresql+psycopg://<DB_APP_USER>:<password>@localhost:5432/asset_health
