# Copy to .env; values below mirror the keys already defined in .project_manifest.yaml.
HEALTHCHECK_PATH=/healthz
LOG_LEVEL=info
TRUST_PROXY=true
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_MAX_AGE=3600

# Database wiring. Leave unset to use the file generated by the database container
# (database_workspace/database/database_urls.env, git-ignored, mode 600), or set explicitly:
# DATABASE_URL=postgresql+psycopg://asset_app:<password>@localhost:5432/asset_health          # runtime role (DML only)
# MIGRATION_DATABASE_URL=postgresql+psycopg://asset_migrator:<password>@localhost:5432/asset_health  # Alembic only
# DATABASE_URLS_FILE=/path/to/database_urls.env
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_S=10

# Development-only local photo storage (DEC-05). This root must be outside the workspace;
# production requires a private, encrypted, shared PhotoStorage adapter (OD-03).
# PHOTO_STORAGE_ROOT=/secure/local/path/asset-health-photos

# Authentication (OD-07). AUTH_TOKEN_SECRET must be requested from the user / secret storage:
# at least 32 random characters. When unset, an ephemeral per-process secret is generated
# (development only: tokens do not survive restarts or work across replicas).
# AUTH_TOKEN_SECRET=
# AUTH_TOKEN_TTL_S=3600
# LOGIN_MAX_FAILURES_PER_USERNAME=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_WINDOW_S=900
# IDEMPOTENCY_TTL_S=86400

# Durable worker (the API and worker are separate processes of the same backend artifact).
# WORKER_POLL_INTERVAL_S=30
# WORKER_LEASE_S=300
# WORKER_NIGHTLY_BATCH_SIZE=100
# WORKER_STAGING_TTL_S=86400
# OUTBOX_MAX_ATTEMPTS=8
# OUTBOX_BACKOFF_CAP_S=3600

# Optional SMTP delivery. Request real credentials from the user or secret storage; never commit
# them. With no SMTP_HOST or SMTP_TO, outbox events remain pending and retry safely.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@asset-health.local
# SMTP_TO=maintenance@example.invalid
# SMTP_STARTTLS=true
# SMTP_TIMEOUT_S=10

# Development seeding (scripts/seed_dev_users.py; never in production). Passwords are generated
# and printed once when unset.
# SEED_MANAGER_USERNAME=manager
# SEED_MANAGER_PASSWORD=
# SEED_CREW_USERNAME=crew
# SEED_CREW_PASSWORD=
